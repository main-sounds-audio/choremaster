#!/usr/bin/env python3
"""Run Chore Master from a checkout without installing it: `bin/choremaster tick`, `bin/choremaster report`."""
import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), ".."))

from choremaster.__main__ import main  # noqa: E402

sys.exit(main())
